# Copier ce fichier en `.env` puis adapter les valeurs. Ne jamais commiter `.env`.

# --- Serveur ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Base de données (PostgreSQL 15 ou plus) ---
DATABASE_URL="postgresql://aicity:aicity@localhost:5432/aicity"

# --- Fichiers téléversés ---
UPLOAD_DIR=uploads

# --- Sécurité (lot L1) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# --- Seed (lot L2) : compte administrateur créé par `npm run seed` si renseigné ---
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# --- Tests : base dédiée, VIDÉE par le test de parcours (jamais la base de dev) ---
TEST_DATABASE_URL="postgresql://aicity:aicity@localhost:5432/aicity_test"
