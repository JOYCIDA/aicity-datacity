# Copier ce fichier en `.env` puis adapter les valeurs. Ne jamais commiter `.env`.

# --- Serveur ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Base de données (PostgreSQL 15 ou plus) ---
DATABASE_URL="postgresql://aicity:aicity@localhost:5432/aicity"

# --- Fichiers téléversés ---
UPLOAD_DIR=uploads

# --- Sécurité (lot L1) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# --- Seed (lot L2) : compte administrateur créé par `npm run seed` si renseigné ---
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# --- Import des données publiques (lot L3) ---
# Planification nocturne (heure de Paris). IMPORT_PLANIFIE=false la désactive (ex. 2e instance PM2).
IMPORT_PLANIFIE=true
CRON_IMPORT="0 3 * * *"
# OpenAgenda : clé publique (compte openagenda.com) et identifiants d'agendas séparés par des virgules.
# Sans clé, la source est ignorée par l'import nocturne.
OPENAGENDA_API_KEY=
OPENAGENDA_AGENDAS=
# data.gouv.fr : jeu et ressource JSON (export OpenAgenda). Par défaut : événements de GPSO.
DATAGOUV_DATASET=5de6fab49ce2e726bfb62c09
DATAGOUV_RESSOURCE=f3e3c20e-4f57-4647-8185-83ade400b490

# --- Tests : base dédiée, VIDÉE par le test de parcours (jamais la base de dev) ---
TEST_DATABASE_URL="postgresql://aicity:aicity@localhost:5432/aicity_test"

# --- Traduction anglaise des offres (facultatif) ---
# aucun : les offres restent en français quand l'anglais est demandé ; deepl : traduction automatique
# (clé gratuite sur deepl.com, 500 000 caractères par mois). `npm run traduire` la lance à la main.
TRADUCTION_FOURNISSEUR=aucun
DEEPL_API_KEY=
# Plafond de caractères envoyés à chaque exécution (protège le quota mensuel).
TRADUCTION_MAX_CARACTERES=100000

# --- Limites par adresse IP ---
# Sessions anonymes de mobile par IP et par 15 minutes (large : Wi-Fi d'école, IP partagée en 4G).
SESSIONS_ANONYMES_MAX=300
# Signalements d'offres par IP et par heure.
SIGNALEMENTS_MAX=20
# Nombre de proxys devant l'API : 0 en local, 1 derrière Nginx (sinon tout le monde partage une IP).
TRUST_PROXY=0
