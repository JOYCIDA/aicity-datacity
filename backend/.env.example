# Copier ce fichier en `.env` puis adapter les valeurs. Ne jamais commiter `.env`.

# --- Serveur ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Base de données (PostgreSQL 15 ou plus) ---
DATABASE_URL="postgresql://aicity:aicity@localhost:5432/aicity"

# --- Fichiers téléversés ---
UPLOAD_DIR=uploads

# --- Sécurité (lot L1) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# --- Seed (lot L2) : compte administrateur créé par `npm run seed` si renseigné ---
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# --- Import des données publiques (lot L3) ---
# Planification nocturne (heure de Paris). IMPORT_PLANIFIE=false la désactive (ex. 2e instance PM2).
IMPORT_PLANIFIE=true
CRON_IMPORT="0 3 * * *"
# OpenAgenda : clé publique (compte openagenda.com) et identifiants d'agendas séparés par des virgules.
# Sans clé, la source est ignorée par l'import nocturne.
OPENAGENDA_API_KEY=
OPENAGENDA_AGENDAS=
# data.gouv.fr : jeu et ressource JSON (export OpenAgenda). Par défaut : événements de GPSO.
DATAGOUV_DATASET=5de6fab49ce2e726bfb62c09
DATAGOUV_RESSOURCE=f3e3c20e-4f57-4647-8185-83ade400b490

# --- Tests : base dédiée, VIDÉE par le test de parcours (jamais la base de dev) ---
TEST_DATABASE_URL="postgresql://aicity:aicity@localhost:5432/aicity_test"
