meta {
  name: Connexion citoyen
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/connexion
  body: json
  auth: none
}

body:json {
  {
    "email": "{{emailCitoyen}}",
    "motDePasse": "motdepasse123"
  }
}

script:post-response {
  bru.setVar("jetonCitoyen", res.body.token);
}

tests {
  test("statut 200", function () {
    expect(res.status).to.equal(200);
  });
}
