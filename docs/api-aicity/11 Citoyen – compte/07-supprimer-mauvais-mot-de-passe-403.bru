meta {
  name: Supprimer mon compte – mauvais mot de passe 403
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/citoyen/compte
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jetonCitoyen}}
}

body:json {
  {
    "motDePasse": "pas-le-bon"
  }
}

tests {
  test("statut 403", function () {
    expect(res.status).to.equal(403);
  });
}

docs {
  Le mot de passe confirme l’action. `403` (et non `401`) : le jeton reste valide, ne pas déconnecter l’usager.
}
